POSTGRES__USER=sample_user
POSTGRES__PASSWORD=sample_password
# Required to start the API at all (main.py loads OpenRouterConfig, whose api_key has
# no default), not only for ingestion's embedding/LLM steps.
OPENROUTER_API_KEY=sk-or-...
# Directory holding the agent YAML files. Defaultless on purpose (spec 0012, AD-22):
# the batch judge and the live judge agree only if they load the same file.
AGENTS_DIR=configs/agents
